PHISHLENS_IMAP_HOST=imap.example.com
PHISHLENS_IMAP_PORT=993
PHISHLENS_IMAP_USER=you@example.com
# Use an application password. No quotes.
PHISHLENS_IMAP_PASSWORD=
PHISHLENS_IMAP_FOLDER=INBOX
PHISHLENS_IMAP_LIMIT=50
# Only if your server uses a private certificate authority:
#PHISHLENS_IMAP_CAFILE=/etc/phishlens/ca.pem
