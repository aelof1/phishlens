# Copy to .env for docker compose (or use with `phishlens web --env-file .env`).
# Never commit your .env: it holds passwords.

# --- Mailbox scanner (docker compose --profile mail) ---
PHISHLENS_IMAP_HOST=imap.example.com
PHISHLENS_IMAP_PORT=993
PHISHLENS_IMAP_USER=you@example.com
# Use an application password. No quotes.
PHISHLENS_IMAP_PASSWORD=
PHISHLENS_IMAP_FOLDER=INBOX
PHISHLENS_IMAP_LIMIT=50
# Language of the scanner's AI answers: fr or en
PHISHLENS_LANG=en

# --- Reverse proxy ---
# Set to 1 only behind Traefik / Caddy / nginx: trusts X-Forwarded-For and X-Forwarded-Proto
# (secure cookies over HTTPS, correct client IP for the login lockout).
#PHISHLENS_TRUST_PROXY=1

# --- AI (optional) ---
# Easiest: configure it in the web interface (Settings). Variables below override the interface.
#PHISHLENS_AI_URL=http://ollama:11434/v1
#PHISHLENS_AI_MODEL=llama3.1
#PHISHLENS_AI_KEY=
